<link rel="stylesheet" href="{{ '/assets/css/profile.css' | relative_url }}">
<script src="{{ '/assets/js/profile.js' | relative_url }}" defer></script>
<div class="language-switch" role="group" aria-label="Language / 语言">
  <button type="button" class="language-option" data-language="zh" aria-pressed="true">中文</button>
  <button type="button" class="language-option" data-language="en" aria-pressed="false">EN</button>
</div>

{% if page.title_en %}
  <span
    hidden
    id="translated-page-title"
    data-title-zh="{{ page.title | escape }}"
    data-title-en="{{ page.title_en | escape }}"
    data-description-zh="{{ page.description | escape }}"
    data-description-en="{{ page.description_en | escape }}"
  ></span>
{% endif %}
